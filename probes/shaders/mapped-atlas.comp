#version 450
layout(local_size_x=32) in;
layout(binding=0) uniform sampler2DArray cp_t2da_tcb_8;
layout(binding=1,std430) buffer cp_s0 { vec4 values[]; } output_values;
struct Query {vec4 coordinate;ivec4 fetch;};
layout(binding=2,std430) readonly buffer cp_s1 { Query values[]; } input_values;
void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=input_values.values.length())return;
    Query q=input_values.values[i];
    if(q.fetch.z==0)output_values.values[i]=texelFetch(cp_t2da_tcb_8,ivec3(q.fetch.xy,int(q.coordinate.w)),q.fetch.w);
    else if(q.fetch.z==1)output_values.values[i]=textureLod(cp_t2da_tcb_8,vec3(q.coordinate.xy,q.coordinate.w),q.coordinate.z);
    else output_values.values[i]=vec4(textureSize(cp_t2da_tcb_8,q.fetch.w),textureQueryLevels(cp_t2da_tcb_8));
}
